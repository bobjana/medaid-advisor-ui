# Vertex AI Agent Engine (chat backend)
# Copy this to .env.local and fill in values.
# These match the deployed agent in ../medaid-advisor-adk/
VERTEX_PROJECT=med-aid-advisor
VERTEX_REGION=us-central1
AGENT_ENGINE_ID=6873004854030106624

# Chat backend: "gcp" (Vertex AI Agent Engine, default) or "local"
# When "local", the chat API route calls the local ADK dev server
# (`adk web medaid_advisor_agent`) instead of Vertex.
CHAT_BACKEND=gcp
# Base URL of the local ADK server (used when CHAT_BACKEND=local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Base URL of the python (FastAPI) parity agent server, used when the chat UI's
# backend toggle is set to "Python". Set it to a different port than the ADK
# server to run both side by side (both default to :8000).
PYTHON_BACKEND_URL=http://localhost:8000
# App name registered on the local ADK server (default: medaid_advisor_agent)
# ADK_APP_NAME=medaid_advisor_agent

# Static login credentials (used by the login API route and middleware)
DEMO_USERNAME=advisor
DEMO_PASSWORD=advisor

# Secret for HMAC signing of session cookies
# Replace with a random 64-character string in production (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-in-production-use-a-random-64-char-string
